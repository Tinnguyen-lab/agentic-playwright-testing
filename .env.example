# SQL Server
DB_SERVER=localhost\\SQLEXPRESS
DB_NAME=AgenticPlaywrightTesting
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server

# OpenAI (hoặc endpoint tương thích OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# --- Chạy bằng LOCAL AI — miễn phí, offline ---
# LM Studio (khuyến nghị, có GUI): Start Server rồi điền:
#   OPENAI_BASE_URL=http://localhost:1234/v1
#   OPENAI_MODEL=qwen2.5-7b-instruct   # đúng model id LM Studio hiển thị ở tab Server
#   OPENAI_API_KEY=lm-studio           # giá trị giả, server local bỏ qua
#
# Ollama (thay thế, dòng lệnh):
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=qwen2.5
#   OPENAI_API_KEY=ollama
#
# Switch nhanh local <-> cloud: giữ .env (local) + tạo .env.cloud (DeepSeek/OpenAI),
# rồi chạy `--profile cloud` để đọc .env.cloud. Xem file .env.cloud mẫu.
